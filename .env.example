DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
API_TIMEOUT=30
SUPERUSERS=[]
COMMAND_START=/
ALCONNA_COMMAND_START=/

# Optional service settings
osu_client=
osu_key=
